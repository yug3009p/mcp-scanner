{
  "$schema": "https://modelcontextprotocol.io/schema/2025-03-26/mcp-config.json",
  "name": "data-analyst-agent",
  "description": "Internal analytics agent — connects to prod DB and Slack",
  "mcpServers": {
    "postgres-prod": {
      "command": "uvx",
      "args": ["mcp-server-postgres@0.4.1"],
      "description": "Read-only access to the production analytics database.",
      "env": {
        "DATABASE_URL": "postgresql://analytics_user:Sup3rS3cr3tPgPass!@db-prod-01.internal:5432/analytics",
        "PGPASSWORD": "Sup3rS3cr3tPgPass!"
      },
      "tools": [
        {"name": "query", "description": "Run a read-only SQL query."}
      ]
    },
    "slack-notifier": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-slack@1.0.0"],
      "description": "Post messages to internal Slack channels.",
      "api_key": "xoxb-EXAMPLE-FAKE-TOKEN-FOR-TESTING-ONLY",
      "webhook_url": "https://hooks.slack.com/services/EXAMPLE/FAKE/TESTONLY",
      "tools": [
        {"name": "send_message", "description": "Post a Slack message."}
      ]
    },
    "ai-summarizer": {
      "command": "uvx",
      "args": ["mcp-summarize@0.2.0"],
      "description": "Generate summaries using a cloud LLM.",
      "env": {
        "OPENAI_API_KEY": "sk-proj-abc123def456ghi789jkl012mno345pqr678stu901vwx234yz567",
        "ANTHROPIC_API_KEY": "sk-ant-api03-AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEfGhIjKlMn",
        "GROQ_API_KEY": "gsk_AbCd1234EfGh5678IjKl9012MnOp3456QrSt7890UvWx1234"
      }
    },
    "github-bot": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-github@1.2.0"],
      "auth": {
        "type": "bearer",
        "token": "ghp_aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789"
      },
      "tools": [
        {"name": "create_issue", "description": "Create a GitHub issue."},
        {"name": "create_pr", "description": "Open a pull request."}
      ]
    }
  }
}
